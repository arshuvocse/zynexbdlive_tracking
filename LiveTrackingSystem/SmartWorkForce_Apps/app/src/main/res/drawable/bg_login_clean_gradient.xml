<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#E6F2FE"
                android:centerColor="#F8FAFC"
                android:endColor="#EBF1FC"
                android:type="linear" />
        </shape>
    </item>
    <item android:bottom="420dp" android:right="60dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="340dp"
                android:startColor="#2638BDF8"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
